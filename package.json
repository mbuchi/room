{
  "name": "room",
  "private": true,
  "version": "0.45.5",
  "type": "module",
  "description": "room - Swiss zoning density explorer: how densely built is this zone, and where does your parcel sit on the distribution?",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbuchi/room.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint --type-aware --tsconfig tsconfig.app.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:bundle-syntax",
    "test:export-fonts": "node scripts/check-export-fonts.mjs",
    "test:bundle-syntax": "node scripts/check-bundle-syntax.mjs",
    "lint:syntax": "oxlint"
  },
  "dependencies": {
    "@aireon/shared": "github:mbuchi/aireon-shared#v1.209.0",
    "@openreplay/tracker": "^18.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.3.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-joyride": "^2.9.3",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-joyride": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-floater": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
